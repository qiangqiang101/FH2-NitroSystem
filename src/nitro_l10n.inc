     "msgstr \"NOS \354\203\201\354\212\271 \354\213\234\352\260\204(\354\264\210)\"\n"
     "\n"
     "msgctxt \"row.BuildupTime.description\"\n"
     "msgid \"Time taken to ramp up to full boost torque (Spire default: 0.5s).\"\n"
     "msgstr \"\353\266\200\354\212\244\355\212\270\352\260\200 \354\265\234\353\214\200\354\227\220 \354\235\264\353\245\274 \353\225\214\352\271\214\354\247\200\354\235\230 \354\213\234\352\260\204\354\236\205\353\213\210\353\213\244(Spire \352\270\260\353\263\270\352\260\222: 0.5\354\264\210).\"\n"
     "\n"
     "msgctxt \"row.RechargeRate.label\"\n"
     "msgid \"NOS Recharge Rate\"\n"
     "msgstr \"NOS \354\266\251\354\240\204 \354\206\215\353\217\204\"\n"
     "\n"
     "msgctxt \"row.RechargeRate.description\"\n"
     "msgid \"Seconds of NOS restored per second while not boosting. Ignored while Require NOS Kit is on: then the NOS Kit's stage sets the recharge rate.\"\n"
     "msgstr \"\353\266\200\354\212\244\355\212\270\355\225\230\354\247\200 \354\225\212\354\235\204 \353\225\214 1\354\264\210\353\247\210\353\213\244 \355\232\214\353\263\265\353\220\230\353\212\224 NOS\354\235\230 \354\264\210\354\236\205\353\213\210\353\213\244. 'NOS \355\202\244\355\212\270 \355\225\204\354\232\224'\352\260\200 \354\274\234\354\240\270 \354\236\210\354\234\274\353\251\264 \353\254\264\354\213\234\353\220\251\353\213\210\353\213\244. \352\267\270\353\225\214\353\212\224 NOS \355\202\244\355\212\270 \353\213\250\352\263\204\352\260\200 \354\266\251\354\240\204 \354\206\215\353\217\204\353\245\274 \354\240\225\355\225\251\353\213\210\353\213\244.\"\n"
     "\n"
     "msgctxt \"row.SoundVolume.label\"\n"
     "msgid \"NOS Sound Volume\"\n"
