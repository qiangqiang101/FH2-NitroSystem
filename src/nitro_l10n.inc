     "\n"
     "msgctxt \"row.SoundVolume.description\"\n"
     "msgid \"Volume of the boost and stop sounds. The game's own volume sliders don't change them.\"\n"
     "msgstr \"\353\266\200\354\212\244\355\212\270\354\231\200 \354\240\225\354\247\200 \354\206\214\353\246\254\354\235\230 \354\235\214\353\237\211\354\236\205\353\213\210\353\213\244. \352\262\214\354\236\204 \354\236\220\354\262\264 \354\235\214\353\237\211 \354\204\244\354\240\225\354\234\274\353\241\234\353\212\224 \353\213\254\353\235\274\354\247\200\354\247\200 \354\225\212\354\212\265\353\213\210\353\213\244.\"\n"
     "\n"
     "msgctxt \"row.DrivatarSoundVolume.label\"\n"
     "msgid \"Drivatar NOS Volume\"\n"
     "msgstr \"Drivatar NOS \354\235\214\353\237\211\"\n"
     "\n"
     "msgctxt \"row.DrivatarSoundVolume.description\"\n"
     "msgid \"Volume of the Drivatars' NOS, heard from their cars (with Drivatar NOS on). 0 silences it.\"\n"
     "msgstr \"Drivatar NOS\354\235\230 \354\235\214\353\237\211\354\234\274\353\241\234, \352\267\270 \354\260\250\354\227\220\354\204\234 \353\223\244\353\246\275\353\213\210\353\213\244(Drivatar NOS\352\260\200 \354\274\234\354\240\270 \354\236\210\354\235\204 \353\225\214). 0\354\235\264\353\251\264 \354\206\214\353\246\254\352\260\200 \353\202\230\354\247\200 \354\225\212\354\212\265\353\213\210\353\213\244.\"\n"
     "\n"
     "msgctxt \"row.CameraShake.label\"\n"
     "msgid \"NOS Camera Shake\"\n"
     "msgstr \"NOS \354\271\264\353\251\224\353\235\274 \355\235\224\353\223\244\353\246\274\"\n"
     "\n"
     "msgctxt \"row.CameraShake.description\"\n"
     "msgid \"How much the camera shakes while NOS is active, in the driver, hood, bumper and chase views. 0 turns it off.\"\n"
     "msgstr \"NOS \354\202\254\354\232\251 \354\244\221 \354\271\264\353\251\224\353\235\274\352\260\200 \355\235\224\353\223\244\353\246\254\353\212\224 \354\240\225\353\217\204\354\236\205\353\213\210\353\213\244(\353\223\234\353\235\274\354\235\264\353\262\204, Bonnet, \353\262\224\355\215\274, \354\266\224\354\240\201 \354\213\234\354\240\220). 0\354\235\264\353\251\264 \352\272\274\354\247\221\353\213\210\353\213\244.\"\n"
     "\n"
     "msgctxt \"row.FovBoost.label\"\n"
     "msgid \"NOS Wider FOV\"\n"
     "msgstr \"NOS \354\213\234\354\225\274 \355\231\225\353\214\200\"\n"
     "\n"
     "msgctxt \"row.FovBoost.description\"\n"
     "msgid \"How much wider the field of view gets while NOS is active, in the driver, hood, bumper and chase views. 0 turns it off.\"\n"
     "msgstr \"NOS \354\202\254\354\232\251 \354\244\221 \354\213\234\354\225\274\352\260\200 \353\204\223\354\226\264\354\247\200\353\212\224 \354\240\225\353\217\204\354\236\205\353\213\210\353\213\244(\353\223\234\353\235\274\354\235\264\353\262\204, Bonnet, \353\262\224\355\215\274, \354\266\224\354\240\201 \354\213\234\354\240\220). 0\354\235\264\353\251\264 \352\272\274\354\247\221\353\213\210\353\213\244.\"\n"
     "\n"
     "msgctxt \"garage.kit.name\"\n"
     "msgid \"NOS Kit\"\n"
     "msgstr \"NOS \355\202\244\355\212\270\"\n"
     "\n"
     "msgctxt \"garage.kit.description\"\n"
     "msgid \"NOS injection. Hold the NOS button while driving; a higher stage has a bigger tank that recharges faster.\"\n"
     "msgstr \"NOS \353\266\204\354\202\254 \354\236\245\354\271\230\354\236\205\353\213\210\353\213\244. \354\243\274\355\226\211 \354\244\221 NOS \353\262\204\355\212\274\354\235\204 \353\210\204\353\245\264\352\263\240 \354\236\210\354\234\274\354\204\270\354\232\224. \353\213\250\352\263\204\352\260\200 \353\206\222\354\235\204\354\210\230\353\241\235 \355\203\261\355\201\254\352\260\200 \354\273\244\354\247\200\352\263\240 \354\266\251\354\240\204\353\217\204 \353\271\250\353\235\274\354\247\221\353\213\210\353\213\244.\"\n"
     "\n"
     "msgctxt \"garage.stock.name\"\n"
     "msgid \"Stock\"\n"
     "msgstr \"\354\210\234\354\240\225\"\n"
     "\n"
     "msgctxt \"garage.stage1.name\"\n"
     "msgid \"Stage 1 NOS\"\n"
     "msgstr \"NOS 1\353\213\250\352\263\204\"\n"
     "\n"
     "msgctxt \"garage.stage2.name\"\n"
