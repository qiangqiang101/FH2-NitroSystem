     "msgstr \"\320\241\320\270\321\201\321\202\320\265\320\274\320\260 \320\275\320\270\321\202\321\200\320\276 ({button})\"\n"
     "\n"
     "msgctxt \"row.NitroEnabled.description\"\n"
     "msgid \"Turns the Fast & Furious NOS on or off. Hold the NOS Button while driving to boost.\"\n"
     "msgstr \"\320\222\320\272\320\273\321\216\321\207\320\260\320\265\321\202 \320\270\320\273\320\270 \320\262\321\213\320\272\320\273\321\216\321\207\320\260\320\265\321\202 NOS \320\262 \321\201\321\202\320\270\320\273\320\265 Fast & Furious. \320\243\320\264\320\265\321\200\320\266\320\270\320\262\320\260\320\271\321\202\320\265 \320\272\320\275\320\276\320\277\320\272\321\203 NOS \320\262\320\276 \320\262\321\200\320\265\320\274\321\217 \320\265\320\267\320\264\321\213 \320\264\320\273\321\217 \321\203\321\201\320\272\320\276\321\200\320\265\320\275\320\270\321\217.\"\n"
     "\n"
     "msgctxt \"row.DebugOverlay.label\"\n"
     "msgid \"NOS Debug Overlay\"\n"
     "msgstr \"\320\236\321\202\320\273\320\260\320\264\320\276\321\207\320\275\321\213\320\271 \320\276\320\262\320\265\321\200\320\273\320\265\320\271 NOS\"\n"
     "\n"
     "msgctxt \"row.DebugOverlay.description\"\n"
     "msgid \"Draws NOS and flame debug info over the game (needs borderless/windowed mode).\"\n"
     "msgstr \"\320\222\321\213\320\262\320\276\320\264\320\270\321\202 \320\277\320\276\320\262\320\265\321\200\321\205 \320\270\320\263\321\200\321\213 \320\276\321\202\320\273\320\260\320\264\320\276\321\207\320\275\321\203\321\216 \320\270\320\275\321\204\320\276\321\200\320\274\320\260\321\206\320\270\321\216 \320\276 NOS \320\270 \320\277\320\273\320\260\320\274\320\265\320\275\320\270 (\320\275\321\203\320\266\320\265\320\275 \320\276\320\272\320\276\320\275\320\275\321\213\320\271 \321\200\320\265\320\266\320\270\320\274 \320\270\320\273\320\270 \321\200\320\265\320\266\320\270\320\274 \320\261\320\265\320\267 \321\200\320\260\320\274\320\272\320\270).\"\n"
     "\n"
     "msgctxt \"row.BackfireOnAllCars.label\"\n"
     "msgid \"Backfire on All Cars\"\n"
     "msgstr \"\320\222\321\213\321\201\321\202\321\200\320\265\320\273\321\213 \320\262\321\213\321\205\320\273\320\276\320\277\320\260 \321\203 \320\262\321\201\320\265\321\205 \320\274\320\260\321\210\320\270\320\275\"\n"
     "\n"
     "msgctxt \"row.BackfireOnAllCars.description\"\n"
     "msgid \"Lets every car backfire, which the NOS exhaust flames need. Off leaves the game's own backfire settings alone. Takes effect after a restart.\"\n"
     "msgstr \"\320\240\320\260\320\267\321\200\320\265\321\210\320\260\320\265\321\202 \320\262\321\213\321\201\321\202\321\200\320\265\320\273\321\213 \320\270\320\267 \320\262\321\213\321\205\320\273\320\276\320\277\320\260 \320\262\321\201\320\265\320\274 \320\274\320\260\321\210\320\270\320\275\320\260\320\274 \342\200\224 \320\276\320\275\320\270 \320\275\321\203\320\266\320\275\321\213 \320\264\320\273\321\217 \320\277\320\273\320\260\320\274\320\265\320\275\320\270 NOS. \320\225\321\201\320\273\320\270 \320\262\321\213\320\272\320\273\321\216\321\207\320\265\320\275\320\276, \320\275\320\260\321\201\321\202\321\200\320\276\320\271\320\272\320\270 \321\201\320\260\320\274\320\276\320\271 \320\270\320\263\321\200\321\213 \320\275\320\265 \320\274\320\265\320\275\321\217\321\216\321\202\321\201\321\217. \320\224\320\265\320\271\321\201\321\202\320\262\321\203\320\265\321\202 \320\277\320\276\321\201\320\273\320\265 \320\277\320\265\321\200\320\265\320\267\320\260\320\277\321\203\321\201\320\272\320\260.\"\n"
     "\n"
     "msgctxt \"row.RefillOnRaceStart.label\"\n"
     "msgid \"Refill NOS on Race Start\"\n"
     "msgstr \"\320\227\320\260\320\277\321\200\320\260\320\262\320\273\321\217\321\202\321\214 NOS \320\275\320\260 \321\201\321\202\320\260\321\200\321\202\320\265 \320\263\320\276\320\275\320\272\320\270\"\n"
     "\n"
     "msgctxt \"row.RefillOnRaceStart.description\"\n"
     "msgid \"Fills the NOS tank when a race starts, you quit one, you change car or you fast travel.\"\n"
     "msgstr \"\320\227\320\260\320\277\320\276\320\273\320\275\321\217\320\265\321\202 \320\261\320\260\320\272 NOS, \320\272\320\276\320\263\320\264\320\260 \320\275\320\260\321\207\320\270\320\275\320\260\320\265\321\202\321\201\321\217 \320\263\320\276\320\275\320\272\320\260, \320\262\321\213 \320\262\321\213\321\205\320\276\320\264\320\270\321\202\320\265 \320\270\320\267 \320\275\320\265\321\221, \320\274\320\265\320\275\321\217\320\265\321\202\320\265 \320\274\320\260\321\210\320\270\320\275\321\203 \320\270\320\273\320\270 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\321\203\320\265\321\202\320\265 \320\261\321\213\321\201\321\202\321\200\320\276\320\265 \320\277\320\265\321\200\320\265\320\274\320\265\321\211\320\265\320\275\320\270\320\265.\"\n"
     "\n"
     "msgctxt \"row.RefundOnRewind.label\"\n"
     "msgid \"Refund NOS on Rewind\"\n"
     "msgstr \"\320\222\320\276\320\267\320\262\321\200\320\260\321\202 NOS \320\277\321\200\320\270 \320\277\320\265\321\200\320\265\320\274\320\276\321\202\320\272\320\265\"\n"
     "\n"
     "msgctxt \"row.RefundOnRewind.description\"\n"
     "msgid \"Rewinding gives back the NOS you used since the point you rewind to.\"\n"
     "msgstr \"\320\237\321\200\320\270 \320\277\320\265\321\200\320\265\320\274\320\276\321\202\320\272\320\265 \320\262\320\276\320\267\320\262\321\200\320\260\321\211\320\260\320\265\321\202\321\201\321\217 NOS, \320\277\320\276\321\202\321\200\320\260\321\207\320\265\320\275\320\275\321\213\320\271 \321\201 \321\202\320\276\320\263\320\276 \320\274\320\276\320\274\320\265\320\275\321\202\320\260, \320\272 \320\272\320\276\321\202\320\276\321\200\320\276\320\274\321\203 \320\262\321\213 \320\262\320\265\321\200\320\275\321\203\320\273\320\270\321\201\321\214.\"\n"
     "\n"
     "msgctxt \"row.Rumble.label\"\n"
     "msgid \"NOS Controller Rumble\"\n"
     "msgstr \"\320\222\320\270\320\261\321\200\320\260\321\206\320\270\321\217 \320\272\320\276\320\275\321\202\321\200\320\276\320\273\320\273\320\265\321\200\320\260 \320\277\321\200\320\270 NOS\"\n"
     "\n"
     "msgctxt \"row.Rumble.description\"\n"
     "msgid \"Rumbles the controller while NOS is active. The game's own rumble isn't affected.\"\n"
     "msgstr \"\320\232\320\276\320\275\321\202\321\200\320\276\320\273\320\273\320\265\321\200 \320\262\320\270\320\261\321\200\320\270\321\200\321\203\320\265\321\202, \320\277\320\276\320\272\320\260 \321\200\320\260\320\261\320\276\321\202\320\260\320\265\321\202 NOS. \320\222\320\270\320\261\321\200\320\260\321\206\320\270\321\217 \321\201\320\260\320\274\320\276\320\271 \320\270\320\263\321\200\321\213 \320\275\320\265 \320\274\320\265\320\275\321\217\320\265\321\202\321\201\321\217.\"\n"
     "\n"
     "msgctxt \"row.DrivatarNitro.label\"\n"
     "msgid \"Drivatar NOS\"\n"
     "msgstr \"NOS \320\260\320\262\320\260\321\202\320\260\321\200\320\276\320\262 \320\263\320\276\320\275\321\211\320\270\320\272\320\276\320\262\"\n"
     "\n"
     "msgctxt \"row.DrivatarNitro.description\"\n"
     "msgid \"Drivatars use NOS too, whenever they can (not before the race starts), from a tank with twice your capacity and recharge, with flames and sound. Not once they're over 100 m ahead of you, so you can catch up. Applies right away.\"\n"
     "msgstr \"\320\220\320\262\320\260\321\202\320\260\321\200\321\213 \320\263\320\276\320\275\321\211\320\270\320\272\320\276\320\262 \321\202\320\276\320\266\320\265 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\321\203\321\216\321\202 NOS, \320\272\320\276\320\263\320\264\320\260 \320\274\320\276\320\263\321\203\321\202 (\320\275\320\276 \320\275\320\265 \320\264\320\276 \321\201\321\202\320\260\321\200\321\202\320\260 \320\263\320\276\320\275\320\272\320\270): \320\261\320\260\320\272 \321\203 \320\275\320\270\321\205 \320\262\320\264\320\262\320\276\320\265 \320\261\320\276\320\273\321\214\321\210\320\265 \320\262\320\260\321\210\320\265\320\263\320\276 \320\270 \320\267\320\260\320\277\321\200\320\260\320\262\320\273\321\217\320\265\321\202\321\201\321\217 \320\262\320\264\320\262\320\276\320\265 \320\261\321\213\321\201\321\202\321\200\320\265\320\265, \321\201 \320\277\320\273\320\260\320\274\320\265\320\275\320\265\320\274 \320\270 \320\267\320\262\321\203\320\272\320\276\320\274. \320\235\320\276 \320\275\320\265 \320\272\320\276\320\263\320\264\320\260 \320\276\320\275\320\270 \320\262\320\277\320\265\321\200\320\265\320\264\320\270 \320\262\320\260\321\201 \320\261\320\276\320\273\321\214\321\210\320\265 \321\207\320\265\320\274 \320\275\320\260 100 \320\274, \321\207\321\202\320\276\320\261\321\213 \320\262\321\213 \320\274\320\276\320\263\320\273\320\270 \320\270\321\205 \320\264\320\276\320\263\320\275\320\260\321\202\321\214. \320\224\320\265\320\271\321\201\321\202\320\262\321\203\320\265\321\202 \321\201\321\200\320\260\320\267\321\203.\"\n"
     "\n"
     "msgctxt \"row.RequireNitrousKit.label\"\n"
     "msgid \"Require NOS Kit\"\n"
     "msgstr \"\320\235\321\203\320\266\320\265\320\275 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202 NOS\"\n"
     "\n"
     "msgctxt \"row.RequireNitrousKit.description\"\n"
     "msgid \"On: only cars with the NOS Kit (Garage > Upgrades > Custom upgrade > Engine) have NOS, and the stage sets the tank and its recharge. Off: every car has NOS, with the NOS Tank Capacity and NOS Recharge Rate, and the NOS Kit isn't in the garage.\"\n"
     "msgstr \"\320\222\320\272\320\273.: NOS \320\265\321\201\321\202\321\214 \321\202\320\276\320\273\321\214\320\272\320\276 \321\203 \320\274\320\260\321\210\320\270\320\275 \321\201 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202\320\276\320\274 NOS (\320\277\320\276\320\272\321\203\320\277\320\260\320\265\321\202\321\201\321\217 \320\262 \320\263\320\260\321\200\320\260\320\266\320\265 \320\272\320\260\320\272 \321\203\320\273\321\203\321\207\321\210\320\265\320\275\320\270\320\265 \320\264\320\262\320\270\320\263\320\260\321\202\320\265\320\273\321\217), \320\260 \321\201\321\202\321\203\320\277\320\265\320\275\321\214 \320\267\320\260\320\264\320\260\321\221\321\202 \320\276\320\261\321\212\321\221\320\274 \320\261\320\260\320\272\320\260 \320\270 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\321\214 \320\262\320\276\321\201\320\277\320\276\320\273\320\275\320\265\320\275\320\270\321\217. \320\222\321\213\320\272\320\273.: NOS \320\265\321\201\321\202\321\214 \321\203 \320\262\321\201\320\265\321\205 \320\274\320\260\321\210\320\270\320\275, \321\201 \320\276\320\261\321\212\321\221\320\274\320\276\320\274 \320\261\320\260\320\272\320\260 NOS \320\270 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\321\214\321\216 \320\262\320\276\321\201\320\277\320\276\320\273\320\275\320\265\320\275\320\270\321\217 NOS, \320\260 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202\320\260 NOS \320\275\320\265\321\202 \320\262 \320\263\320\260\321\200\320\260\320\266\320\265.\"\n"
     "\n"
     "msgctxt \"row.HudHide.label\"\n"
     "msgid \"Hide NOS Gauge Without Kit\"\n"
     "msgstr \"\320\241\320\272\321\200\321\213\320\262\320\260\321\202\321\214 \321\210\320\272\320\260\320\273\321\203 \320\261\320\265\320\267 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202\320\260\"\n"
     "\n"
     "msgctxt \"row.HudHide.description\"\n"
     "msgid \"On: the NOS gauge frame is hidden on cars without a NOS Kit. Off: an empty frame stays.\"\n"
     "msgstr \"\320\222\320\272\320\273.: \321\200\320\260\320\274\320\272\320\260 \321\210\320\272\320\260\320\273\321\213 NOS \321\201\320\272\321\200\321\213\321\202\320\260 \321\203 \320\274\320\260\321\210\320\270\320\275 \320\261\320\265\320\267 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202\320\260 NOS. \320\222\321\213\320\272\320\273.: \320\276\321\201\321\202\320\260\321\221\321\202\321\201\321\217 \320\277\321\203\321\201\321\202\320\260\321\217 \321\200\320\260\320\274\320\272\320\260.\"\n"
     "\n"
     "msgctxt \"row.VignetteEnabled.label\"\n"
     "msgid \"NOS Blue Vignette\"\n"
     "msgstr \"\320\241\320\270\320\275\321\217\321\217 \320\262\320\270\320\275\321\214\320\265\321\202\320\272\320\260 NOS\"\n"
     "\n"
     "msgctxt \"row.VignetteEnabled.description\"\n"
     "msgid \"A pulsing blue vignette at the screen edges while NOS is active.\"\n"
     "msgstr \"\320\237\321\203\320\273\321\214\321\201\320\270\321\200\321\203\321\216\321\211\320\260\321\217 \321\201\320\270\320\275\321\217\321\217 \320\262\320\270\320\275\321\214\320\265\321\202\320\272\320\260 \320\277\320\276 \320\272\321\200\320\260\321\217\320\274 \321\215\320\272\321\200\320\260\320\275\320\260, \320\277\320\276\320\272\320\260 \321\200\320\260\320\261\320\276\321\202\320\260\320\265\321\202 NOS.\"\n"
     "\n"
     "msgctxt \"row.SpeedLinesEnabled.label\"\n"
     "msgid \"NOS Speed Lines\"\n"
     "msgstr \"\320\233\320\270\320\275\320\270\320\270 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\320\270 NOS\"\n"
     "\n"
     "msgctxt \"row.SpeedLinesEnabled.description\"\n"
     "msgid \"Thin blue streaks flying out toward the screen edges while NOS is active, in step with the car's speed.\"\n"
     "msgstr \"\320\242\320\276\320\275\320\272\320\270\320\265 \321\201\320\270\320\275\320\270\320\265 \320\277\320\276\320\273\320\276\321\201\321\213 \320\273\320\265\321\202\321\217\321\202 \320\272 \320\272\321\200\320\260\321\217\320\274 \321\215\320\272\321\200\320\260\320\275\320\260, \320\277\320\276\320\272\320\260 \321\200\320\260\320\261\320\276\321\202\320\260\320\265\321\202 NOS, \320\262 \321\202\320\260\320\272\321\202 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\320\270 \320\274\320\260\321\210\320\270\320\275\321\213.\"\n"
     "\n"
     "msgctxt \"row.NitroButton.label\"\n"
     "msgid \"NOS Button\"\n"
     "msgstr \"\320\232\320\275\320\276\320\277\320\272\320\260 NOS\"\n"
     "\n"
     "msgctxt \"row.NitroButton.description\"\n"
     "msgid \"Which button burns NOS. Pick one the game doesn't use while driving. Applies right away.\"\n"
     "msgstr \"\320\232\320\275\320\276\320\277\320\272\320\260, \320\262\320\272\320\273\321\216\321\207\320\260\321\216\321\211\320\260\321\217 NOS. \320\222\321\213\320\261\320\265\321\200\320\270\321\202\320\265 \321\202\321\203, \321\207\321\202\320\276 \320\270\320\263\321\200\320\260 \320\275\320\265 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\321\203\320\265\321\202 \320\262\320\276 \320\262\321\200\320\265\320\274\321\217 \320\265\320\267\320\264\321\213. \320\224\320\265\320\271\321\201\321\202\320\262\321\203\320\265\321\202 \321\201\321\200\320\260\320\267\321\203.\"\n"
     "\n"
     "msgctxt \"row.NitroButton.slider_description\"\n"
     "msgid \"1 LB, 2 RB, 3 A, 4 B, 5 X, 6 Y, 7 LS click, 8 RS click, 9 D-Pad Up, 10 D-Pad Down, 11 D-Pad Left, 12 D-Pad Right, 13 Back, 14 Start, 15 LT, 16 RT. Pick one the game doesn't use while driving. Applies right away.\"\n"
     "msgstr \"1 LB, 2 RB, 3 A, 4 B, 5 X, 6 Y, 7 LS click, 8 RS click, 9 D-Pad Up, 10 D-Pad Down, 11 D-Pad Left, 12 D-Pad Right, 13 Back, 14 Start, 15 LT, 16 RT. \320\222\321\213\320\261\320\265\321\200\320\270\321\202\320\265 \321\202\321\203, \321\207\321\202\320\276 \320\270\320\263\321\200\320\260 \320\275\320\265 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\321\203\320\265\321\202 \320\262\320\276 \320\262\321\200\320\265\320\274\321\217 \320\265\320\267\320\264\321\213. \320\224\320\265\320\271\321\201\321\202\320\262\321\203\320\265\321\202 \321\201\321\200\320\260\320\267\321\203.\"\n"
     "\n"
     "msgctxt \"row.HudTheme.label\"\n"
     "msgid \"HUD Theme\"\n"
     "msgstr \"\320\242\320\265\320\274\320\260 \320\277\321\200\320\270\320\261\320\276\321\200\320\275\320\276\320\271 \320\277\320\260\320\275\320\265\320\273\320\270\"\n"
     "\n"
     "msgctxt \"row.HudTheme.choice.0\"\n"
     "msgid \"Original\"\n"
     "msgstr \"\320\236\321\200\320\270\320\263\320\270\320\275\320\260\320\273\"\n"
     "\n"
     "msgctxt \"row.HudTheme.description\"\n"
     "msgid \"Original: the game's HUD with a yellow NOS bar. Fast & Furious: cyan NOS bar, gears and assist icons.\"\n"
     "msgstr \"\320\236\321\200\320\270\320\263\320\270\320\275\320\260\320\273: \320\277\321\200\320\270\320\261\320\276\321\200\320\275\320\260\321\217 \320\277\320\260\320\275\320\265\320\273\321\214 \320\270\320\263\321\200\321\213 \321\201 \320\266\321\221\320\273\321\202\320\276\320\271 \320\277\320\276\320\273\320\276\321\201\320\276\320\271 NOS. Fast & Furious: \320\277\320\276\320\273\320\276\321\201\320\260 NOS, \320\277\320\265\321\200\320\265\320\264\320\260\321\207\320\270 \320\270 \320\267\320\275\320\260\321\207\320\272\320\270 \320\277\320\276\320\274\320\276\321\211\320\275\320\270\320\272\320\276\320\262 \320\263\320\276\320\273\321\203\320\261\320\276\320\263\320\276 \321\206\320\262\320\265\321\202\320\260.\"\n"
     "\n"
     "msgctxt \"row.HudTheme.slider_description\"\n"
     "msgid \"1 Original (yellow NOS bar), 2 Fast & Furious (cyan NOS bar, gears and assist icons).\"\n"
     "msgstr \"1 \320\236\321\200\320\270\320\263\320\270\320\275\320\260\320\273 (\320\266\321\221\320\273\321\202\320\260\321\217 \320\277\320\276\320\273\320\276\321\201\320\260 NOS), 2 Fast & Furious (\320\277\320\276\320\273\320\276\321\201\320\260 NOS, \320\277\320\265\321\200\320\265\320\264\320\260\321\207\320\270 \320\270 \320\267\320\275\320\260\321\207\320\272\320\270 \320\277\320\276\320\274\320\276\321\211\320\275\320\270\320\272\320\276\320\262 \320\263\320\276\320\273\321\203\320\261\320\276\320\263\320\276 \321\206\320\262\320\265\321\202\320\260).\"\n"
     "\n"
     "msgctxt \"row.TorqueScale.label\"\n"
     "msgid \"NOS Boost Multiplier\"\n"
     "msgstr \"\320\234\320\275\320\276\320\266\320\270\321\202\320\265\320\273\321\214 NOS\"\n"
     "\n"
     "msgctxt \"row.TorqueScale.description\"\n"
     "msgid \"Multiplies forward acceleration while NOS is active (Spire default: 1.6x).\"\n"
     "msgstr \"\320\243\320\274\320\275\320\276\320\266\320\260\320\265\321\202 \321\203\321\201\320\272\320\276\321\200\320\265\320\275\320\270\320\265 \320\262\320\277\320\265\321\200\321\221\320\264, \320\277\320\276\320\272\320\260 \321\200\320\260\320\261\320\276\321\202\320\260\320\265\321\202 NOS (\320\277\320\276 \321\203\320\274\320\276\320\273\321\207\320\260\320\275\320\270\321\216 \320\262 Spire: 1,6x).\"\n"
     "\n"
     "msgctxt \"row.Duration.label\"\n"
     "msgid \"NOS Tank Capacity (sec)\"\n"
     "msgstr \"\320\236\320\261\321\212\321\221\320\274 \320\261\320\260\320\272\320\260 NOS (\321\201)\"\n"
     "\n"
     "msgctxt \"row.Duration.description\"\n"
     "msgid \"Total seconds of continuous boost available in a full tank (Spire default: 20s). Ignored while Require NOS Kit is on: then the NOS Kit's stage sets the tank.\"\n"
     "msgstr \"\320\241\320\272\320\276\320\273\321\214\320\272\320\276 \321\201\320\265\320\272\321\203\320\275\320\264 \320\275\320\265\320\277\321\200\320\265\321\200\321\213\320\262\320\275\320\276\320\263\320\276 \321\203\321\201\320\272\320\276\321\200\320\265\320\275\320\270\321\217 \320\264\320\260\321\221\321\202 \320\277\320\276\320\273\320\275\321\213\320\271 \320\261\320\260\320\272 (\320\277\320\276 \321\203\320\274\320\276\320\273\321\207\320\260\320\275\320\270\321\216 \320\262 Spire: 20 \321\201). \320\235\320\265 \320\264\320\265\320\271\321\201\321\202\320\262\321\203\320\265\321\202, \320\272\320\276\320\263\320\264\320\260 \320\262\320\272\320\273\321\216\321\207\320\265\320\275\320\276 \302\253\320\235\321\203\320\266\320\265\320\275 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202 NOS\302\273: \321\202\320\276\320\263\320\264\320\260 \320\261\320\260\320\272 \320\267\320\260\320\264\320\260\321\221\321\202 \321\201\321\202\321\203\320\277\320\265\320\275\321\214 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202\320\260 NOS.\"\n"
     "\n"
     "msgctxt \"row.BuildupTime.label\"\n"
     "msgid \"NOS Buildup Time (sec)\"\n"
     "msgstr \"\320\222\321\200\320\265\320\274\321\217 \321\200\320\260\320\267\320\263\320\276\320\275\320\260 NOS (\321\201)\"\n"
     "\n"
     "msgctxt \"row.BuildupTime.description\"\n"
     "msgid \"Time taken to ramp up to full boost torque (Spire default: 0.5s).\"\n"
     "msgstr \"\320\222\321\200\320\265\320\274\321\217, \320\267\320\260 \320\272\320\276\321\202\320\276\321\200\320\276\320\265 NOS \320\262\321\213\321\205\320\276\320\264\320\270\321\202 \320\275\320\260 \320\277\320\276\320\273\320\275\321\203\321\216 \321\201\320\270\320\273\321\203 (\320\277\320\276 \321\203\320\274\320\276\320\273\321\207\320\260\320\275\320\270\321\216 \320\262 Spire: 0,5 \321\201).\"\n"
     "\n"
     "msgctxt \"row.RechargeRate.label\"\n"
     "msgid \"NOS Recharge Rate\"\n"
     "msgstr \"\320\241\320\272\320\276\321\200\320\276\321\201\321\202\321\214 \320\262\320\276\321\201\320\277\320\276\320\273\320\275\320\265\320\275\320\270\321\217 NOS\"\n"
     "\n"
     "msgctxt \"row.RechargeRate.description\"\n"
     "msgid \"Seconds of NOS restored per second while not boosting. Ignored while Require NOS Kit is on: then the NOS Kit's stage sets the recharge rate.\"\n"
     "msgstr \"\320\241\320\272\320\276\320\273\321\214\320\272\320\276 \321\201\320\265\320\272\321\203\320\275\320\264 NOS \320\262\320\276\321\201\320\277\320\276\320\273\320\275\321\217\320\265\321\202\321\201\321\217 \320\267\320\260 \321\201\320\265\320\272\321\203\320\275\320\264\321\203 \320\261\320\265\320\267 \321\203\321\201\320\272\320\276\321\200\320\265\320\275\320\270\321\217. \320\235\320\265 \320\264\320\265\320\271\321\201\321\202\320\262\321\203\320\265\321\202, \320\272\320\276\320\263\320\264\320\260 \320\262\320\272\320\273\321\216\321\207\320\265\320\275\320\276 \302\253\320\235\321\203\320\266\320\265\320\275 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202 NOS\302\273: \321\202\320\276\320\263\320\264\320\260 \321\201\320\272\320\276\321\200\320\276\321\201\321\202\321\214 \320\262\320\276\321\201\320\277\320\276\320\273\320\275\320\265\320\275\320\270\321\217 \320\267\320\260\320\264\320\260\321\221\321\202 \321\201\321\202\321\203\320\277\320\265\320\275\321\214 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202\320\260 NOS.\"\n"
     "\n"
     "msgctxt \"row.SoundVolume.label\"\n"
     "msgid \"NOS Sound Volume\"\n"
     "msgstr \"\320\223\321\200\320\276\320\274\320\272\320\276\321\201\321\202\321\214 \320\267\320\262\321\203\320\272\320\260 NOS\"\n"
     "\n"
     "msgctxt \"row.SoundVolume.description\"\n"
     "msgid \"Volume of the boost and stop sounds. The game's own volume sliders don't change them.\"\n"
