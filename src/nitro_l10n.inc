     "msgstr \"NOS \345\225\237\345\213\225\346\231\202\350\256\223\346\216\247\345\210\266\345\231\250\351\234\207\345\213\225\343\200\202\344\270\215\345\275\261\351\237\277\351\201\212\346\210\262\346\234\254\350\272\253\347\232\204\351\234\207\345\213\225\343\200\202\"\n"
