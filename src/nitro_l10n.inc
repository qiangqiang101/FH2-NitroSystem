     "msgstr \"\346\257\224\350\263\275\351\226\213\345\247\213\346\231\202\350\243\234\346\273\277 NOS\"\n"
     "\n"
     "msgctxt \"row.RefillOnRaceStart.description\"\n"
     "msgid \"Fills the NOS tank when a race starts, you quit one, you change car or you fast travel.\"\n"
     "msgstr \"\346\257\224\350\263\275\351\226\213\345\247\213\343\200\201\351\200\200\345\207\272\346\257\224\350\263\275\343\200\201\346\233\264\346\217\233\350\273\212\350\274\233\346\210\226\345\277\253\351\200\237\347\247\273\345\213\225\346\231\202\357\274\214\345\260\207 NOS \350\243\234\346\273\277\343\200\202\"\n"
