     "msgstr \"Drivatar \344\271\237\346\234\203\347\233\241\345\217\257\350\203\275\344\275\277\347\224\250 NOS (\346\257\224\350\263\275\351\226\213\345\247\213\345\211\215\351\231\244\345\244\226)\357\274\214\345\256\271\351\207\217\350\210\207\345\233\236\345\205\205\351\200\237\345\272\246\346\230\257\344\275\240\347\232\204\345\205\251\345\200\215\357\274\214\344\270\246\346\234\211\345\231\264\347\201\253\350\210\207\351\237\263\346\225\210\343\200\202\351\240\230\345\205\210\344\275\240\350\266\205\351\201\216 100 \345\205\254\345\260\272\346\231\202\344\270\215\346\234\203\344\275\277\347\224\250\357\274\214\350\256\223\344\275\240\350\203\275\345\244\240\350\277\275\344\270\212\343\200\202\347\253\213\345\215\263\347\224\237\346\225\210\343\200\202\"\n"
     "\n"
