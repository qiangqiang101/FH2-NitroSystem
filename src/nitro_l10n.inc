     "msgctxt \"row.HudTheme.choice.0\"\n"
     "msgid \"Original\"\n"
     "msgstr \"\354\230\244\353\246\254\354\247\200\353\204\220\"\n"
     "\n"
     "msgctxt \"row.HudTheme.description\"\n"
     "msgid \"Original: the game's HUD with a yellow NOS bar. Fast & Furious: cyan NOS bar, gears and assist icons.\"\n"
     "msgstr \"\354\230\244\353\246\254\354\247\200\353\204\220: \353\205\270\353\236\200\354\203\211 NOS \353\260\224\352\260\200 \354\236\210\353\212\224 \352\262\214\354\236\204 \352\270\260\353\263\270 HUD. Fast & Furious: \354\262\255\353\241\235\354\203\211 NOS \353\260\224, \352\270\260\354\226\264, \353\263\264\354\241\260 \354\225\204\354\235\264\354\275\230.\"\n"
     "\n"
     "msgctxt \"row.HudTheme.slider_description\"\n"
     "msgid \"1 Original (yellow NOS bar), 2 Fast & Furious (cyan NOS bar, gears and assist icons).\"\n"
     "msgstr \"1 \354\230\244\353\246\254\354\247\200\353\204\220(\353\205\270\353\236\200\354\203\211 NOS \353\260\224), 2 Fast & Furious(\354\262\255\353\241\235\354\203\211 NOS \353\260\224, \352\270\260\354\226\264, \353\263\264\354\241\260 \354\225\204\354\235\264\354\275\230).\"\n"
     "\n"
     "msgctxt \"row.TorqueScale.label\"\n"
