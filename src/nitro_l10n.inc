     "\n"
     "msgctxt \"row.DebugOverlay.description\"\n"
     "msgid \"Draws NOS and flame debug info over the game (needs borderless/windowed mode).\"\n"
     "msgstr \"\345\234\250\351\201\212\346\210\262\347\225\253\351\235\242\344\270\212\351\241\257\347\244\272 NOS \350\210\207\345\231\264\347\201\253\347\232\204\351\231\244\351\214\257\350\263\207\350\250\212 (\351\234\200\350\246\201\350\246\226\347\252\227\346\210\226\347\204\241\351\202\212\347\225\214\350\246\226\347\252\227\346\250\241\345\274\217)\343\200\202\"\n"
