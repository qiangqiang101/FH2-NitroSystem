     "msgid \"Require NOS Kit\"\n"
     "msgstr \"\351\234\200\350\246\201 NOS \345\245\227\344\273\266\"\n"
     "\n"
     "msgctxt \"row.RequireNitrousKit.description\"\n"
     "msgid \"On: only cars with the NOS Kit (Garage > Upgrades > Custom upgrade > Engine) have NOS, and the stage sets the tank and its recharge. Off: every car has NOS, with the NOS Tank Capacity and NOS Recharge Rate, and the NOS Kit isn't in the garage.\"\n"
     "msgstr \"\351\226\213\345\225\237\357\274\232\345\217\252\346\234\211\350\243\235\344\272\206 NOS \345\245\227\344\273\266 (\345\234\250\350\273\212\345\272\253\344\273\245\345\274\225\346\223\216\345\215\207\347\264\232\350\263\274\350\262\267) \347\232\204\350\273\212\350\274\233\346\234\211 NOS\357\274\214\351\232\216\346\256\265\346\261\272\345\256\232\345\256\271\351\207\217\350\210\207\345\233\236\345\205\205\351\200\237\345\272\246\343\200\202\351\227\234\351\226\211\357\274\232\346\211\200\346\234\211\350\273\212\350\274\233\351\203\275\346\234\211 NOS\357\274\214\344\275\277\347\224\250 NOS \345\256\271\351\207\217\350\210\207 NOS \345\233\236\345\205\205\351\200\237\345\272\246\357\274\214\350\273\212\345\272\253\344\270\255\344\270\215\346\234\203\345\207\272\347\217\276 NOS \345\245\227\344\273\266\343\200\202\"\n"
     "\n"
