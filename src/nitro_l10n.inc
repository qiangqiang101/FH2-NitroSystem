     "msgstr \"\345\200\222\350\275\211\346\231\202\357\274\214\346\234\203\350\277\224\351\202\204\350\207\252\345\200\222\350\275\211\351\273\236\344\271\213\345\276\214\347\224\250\346\216\211\347\232\204 NOS\343\200\202\"\n"
