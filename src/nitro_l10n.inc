     "msgstr \"NOS \354\202\254\354\232\251 \354\244\221 \354\240\204\354\247\204 \352\260\200\354\206\215\354\235\204 \353\260\260\353\241\234 \353\212\230\353\246\275\353\213\210\353\213\244(Spire \352\270\260\353\263\270\352\260\222: 1.6\353\260\260).\"\n"
     "\n"
     "msgctxt \"row.Duration.label\"\n"
     "msgid \"NOS Tank Capacity (sec)\"\n"
     "msgstr \"NOS \355\203\261\355\201\254 \354\232\251\353\237\211(\354\264\210)\"\n"
     "\n"
     "msgctxt \"row.Duration.description\"\n"
     "msgid \"Total seconds of continuous boost available in a full tank (Spire default: 20s). Ignored while Require NOS Kit is on: then the NOS Kit's stage sets the tank.\"\n"
     "msgstr \"\352\260\200\353\223\235 \354\260\254 \355\203\261\355\201\254\353\241\234 \352\263\204\354\206\215 \353\266\200\354\212\244\355\212\270\355\225\240 \354\210\230 \354\236\210\353\212\224 \354\264\210\354\236\205\353\213\210\353\213\244(Spire \352\270\260\353\263\270\352\260\222: 20\354\264\210). 'NOS \355\202\244\355\212\270 \355\225\204\354\232\224'\352\260\200 \354\274\234\354\240\270 \354\236\210\354\234\274\353\251\264 \353\254\264\354\213\234\353\220\251\353\213\210\353\213\244. \352\267\270\353\225\214\353\212\224 NOS \355\202\244\355\212\270 \353\213\250\352\263\204\352\260\200 \355\203\261\355\201\254\353\245\274 \354\240\225\355\225\251\353\213\210\353\213\244.\"\n"
     "\n"
