     "msgctxt \"garage.stock.description\"\n"
     "msgid \"No NOS fitted.\"\n"
     "msgstr \"NOS\352\260\200 \354\236\245\354\260\251\353\220\230\354\247\200 \354\225\212\354\225\230\354\212\265\353\213\210\353\213\244.\"\n"
     "\n"
     "msgctxt \"garage.stage.description\"\n"
     "msgid \"NOS, stage {n}: {s} s tank, recharges {r} s per second.\"\n"
     "msgstr \"NOS {n}\353\213\250\352\263\204: \355\203\261\355\201\254 {s}\354\264\210, 1\354\264\210\354\227\220 {r}\354\264\210 \354\266\251\354\240\204.\"\n"
